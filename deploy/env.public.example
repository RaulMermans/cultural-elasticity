# Public-process environment matrix. Copy values into the host's secret store.
# Never commit filled values. Never set NEXT_PUBLIC_ for any of these.

# --- Frontend (Vercel or equivalent, server-only) ---
# NODE_ENV=production
# BACKEND_URL=https://<backend-host>
# CE_INTERNAL_API_SECRET=<same 32+ char secret as the backend>

# --- Backend (Railway primary / Render fallback, one instance) ---
NODE_ENV=production
CE_PUBLIC_DEPLOYMENT=1
HOST=0.0.0.0
# PORT is injected by the host. Do not hard-code a conflicting value on Railway/Render.
LOG_LEVEL=info
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
QLOO_CALL_SPACING_MS=7000
CE_ACCEPT_INVESTIGATIONS=1
CE_JOB_CREATE_LIMIT=24
CE_GLOBAL_JOB_LIMIT=96
CE_SPEND_BUDGET_USD=25
CE_INVESTIGATION_RESERVE_USD=1
# CE_INTERNAL_API_SECRET=
# CE_OPERATOR_TOKEN=
# QLOO_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# AGENT_QLOO_TRANSPORT=mcp
