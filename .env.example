# Copy to backend/.env for local development. Never commit the real file.
# The key is read only by the backend process and the Qloo harness child process.
# It must never appear in frontend code, browser-visible config (NEXT_PUBLIC_*), logs, docs, or fixtures.
QLOO_API_KEY=

# Backend
PORT=4000
HOST=127.0.0.1

# Frontend (server-side only; not exposed to the browser)
BACKEND_URL=http://127.0.0.1:4000
