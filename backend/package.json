{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "feasibility:qloo": "tsx scripts/qloo-feasibility.ts",
    "eval:methodology": "tsx scripts/eval-methodology.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "capture:elasticity": "tsx scripts/elasticity-capture.ts",
    "eval:elasticity": "tsx scripts/eval-elasticity.ts",
    "methodology:jacquemus": "tsx scripts/methodology-jacquemus.ts",
    "agent:run": "tsx scripts/agent-run.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "eval:agent:live": "tsx scripts/eval-agent-live.ts",
    "eval:agent:budget": "tsx scripts/live-gate-budget.ts",
    "eval:agent:replay": "tsx scripts/replay-evaluators.ts",
    "eval:query": "tsx scripts/eval-query.ts",
    "living-atlas:live": "tsx scripts/living-atlas-live.ts",
    "perf:agent": "tsx scripts/perf-agent.ts",
    "perf:live-trace": "tsx scripts/perf-live-trace.ts",
    "effort:compare": "tsx scripts/effort-compare.ts",
    "poc:vercel": "tsx scripts/vercel-feasibility/run-poc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@cultural-elasticity/shared": "workspace:*",
    "@qloo/qloo-harness": "0.1.26",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
