{
  "name": "cultural-elasticity",
  "private": true,
  "description": "Agentic cultural-intelligence product measuring how far a brand can stretch before it stops feeling like itself.",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "check:secrets": "node scripts/check-secrets.mjs",
    "eval:methodology": "pnpm --filter backend eval:methodology",
    "eval:live": "pnpm --filter backend eval:live",
    "eval:elasticity": "pnpm --filter backend eval:elasticity",
    "methodology:jacquemus": "pnpm --filter backend methodology:jacquemus",
    "feasibility:qloo": "pnpm --filter backend feasibility:qloo",
    "capture:elasticity": "pnpm --filter backend capture:elasticity",
    "agent:run": "pnpm --filter backend agent:run",
    "eval:agent": "pnpm --filter backend eval:agent",
    "eval:agent:live": "pnpm --filter backend eval:agent:live",
    "eval:agent:replay": "pnpm --filter backend eval:agent:replay",
    "eval:query": "pnpm --filter backend eval:query",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "smoke:offline": "node scripts/smoke-offline.mjs",
    "smoke:docker": "bash scripts/smoke-docker.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
