{
 "fixtureType": "synthetic",
 "notice": "SYNTHETIC agent-runtime evaluation scenarios. They run against evals/fixtures/synthetic/agent/world.json (fictional names, SYN- ids) and test runtime control flow and deterministic guarantees. They are NOT Qloo validation and NOT a live model validation.",
 "version": "agent-eval-v1",
 "scenarios": [
  {
   "id": "ir-move",
   "category": "INTENT_ROUTING",
   "description": "Single move: brand + one territory routes to analyze_move and reaches a full relative analysis via agent-chosen references.",
   "policy": "baseline",
   "request": {
    "userQuery": "Could Northwind Atelier enter boutique hospitality?",
    "brand": "Northwind Atelier",
    "territories": [
     "Boutique Hospitality"
    ]
   },
   "expect": {
    "status": "COMPLETE",
    "intent": "analyze_move",
    "routes": {
     "boutique_hospitality": "FULL_RELATIVE_ANALYSIS"
    },
    "methodologyRuns": 1,
    "toolsCalled": [
     "qloo_resolve_entity",
     "qloo_find_tags",
     "qloo_recommend",
     "validate_territory_representation"
    ],
    "generalization": "G3"
   }
  },
  {
   "id": "ir-compare",
   "category": "INTENT_ROUTING",
   "description": "Three named territories route to compare_territories; only two are brand-rankable, so no comparison set exists and every territory is partial.",
   "policy": "baseline",
   "request": {
    "userQuery": "For Saffron & Salt compare tableware, skincare and slow travel",
    "brand": "Saffron & Salt",
    "territories": [
     "Tableware",
     "Skincare",
     "Slow Travel"
    ]
   },
   "expect": {
    "status": "COMPLETE",
    "intent": "compare_territories",
    "routes": {
     "tableware": "PARTIAL_CULTURAL_ANALYSIS",
     "skincare": "PARTIAL_CULTURAL_ANALYSIS",
     "slow_travel": "PARTIAL_CULTURAL_ANALYSIS"
    },
    "methodologyRuns": 0,
    "limitationCodes": [
     "COMPARISON_SET_TOO_SMALL"
    ],
    "generalization": "G5"
   }
  },
  {
   "id": "ir-frontier",
   "category": "INTENT_ROUTING",
   "description": "No territories routes to explore_frontier; candidates are discovered from Qloo evidence.",
   "policy": "baseline",
