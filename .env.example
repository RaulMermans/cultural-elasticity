# Copy to backend/.env for local development. Never commit the real file.
# The key is read only by the backend process and the Qloo harness child process.
# It must never appear in frontend code, browser-visible config (NEXT_PUBLIC_*), logs, docs, or fixtures.
QLOO_API_KEY=
# Hackathon keys work ONLY against this host (not api.qloo.com, not staging.api.qloo.com).
# Non-secret but backend-only. Required for live runs; there is deliberately no default.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Agent model (optional). With no key, the agent cannot run live (LIVE_AGENT_MODEL_VALIDATION_NOT_RUN);
# the deterministic baseline reference policy can still be selected explicitly. Backend-only, never committed.
ANTHROPIC_API_KEY=
# Only when the key is not scoped to a workspace (the API then requires the anthropic-workspace-id header).
ANTHROPIC_WORKSPACE_ID=
# Production model is claude-haiku-5-5 (the default; Sprint 5A). Override for development only — no fallback, no escalation.
# AGENT_MODEL=claude-haiku-5-5
# AGENT_EFFORT=high
# Qloo tool boundary for the agent: mcp (default, `qloo mcp`) or exec (verified fallback).
# AGENT_QLOO_TRANSPORT=mcp
# Spacing between live Qloo calls in ms (rate-limit safety; Sprint 2 used 7000).
# QLOO_CALL_SPACING_MS=7000

# Backend
PORT=4000
HOST=127.0.0.1

# Frontend (server-side only; not exposed to the browser)
BACKEND_URL=http://127.0.0.1:4000

# Public deployment (backend). Leave unset for local development.
# CE_PUBLIC_DEPLOYMENT=1
# CE_INTERNAL_API_SECRET=
# CE_OPERATOR_TOKEN=
# CE_SPEND_BUDGET_USD=25
# CE_INVESTIGATION_RESERVE_USD=1
# CE_ACCEPT_INVESTIGATIONS=1
# CE_JOB_CREATE_LIMIT=24
# CE_GLOBAL_JOB_LIMIT=96

# Frontend public host (server-side only). Same CE_INTERNAL_API_SECRET as the backend.
# CE_INTERNAL_API_SECRET=
